
RewriteEngine On

# ----------------------------------------------------------------------
# SECURITY: Block Source Code & Sensitive File Access
# ----------------------------------------------------------------------
RewriteRule \.(ts|tsx|jsx|env|config|json|lock|git|yml)$ - [F,L]

# ----------------------------------------------------------------------
# Hostinger / Apache Proxy Configuration
# ----------------------------------------------------------------------
# If PORT is explicitly defined as a numeric port (e.g., SetEnv PORT 3000), proxy traffic to localhost.
# On standard Hostinger Node.js (Passenger) setups, Passenger handles routing directly via sockets.
<IfModule mod_rewrite.c>
  RewriteCond %{ENV:PORT} ^[0-9]+$
  RewriteRule ^(.*)$ http://127.0.0.1:%{ENV:PORT}/$1 [P,L]
</IfModule>


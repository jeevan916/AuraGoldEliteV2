
RewriteEngine On

# ----------------------------------------------------------------------
# SECURITY: Block Source Code Access
# ----------------------------------------------------------------------
# Prevents users from downloading source code, configs, and secrets.
# Returns a 403 Forbidden error for these file types.
# ----------------------------------------------------------------------
RewriteRule \.(ts|tsx|jsx|env|config|json|lock|git|yml)$ - [F,L]

# ----------------------------------------------------------------------
# Hostinger Node.js Proxy Configuration
# ----------------------------------------------------------------------
# Forward requests to backend Node.js application ONLY if ENV:PORT is explicitly set as a numeric port (e.g., SetEnv PORT 3000).
# This prevents Apache/LiteSpeed from proxying to an unassigned port 3000, which causes HTTP 503 Service Unavailable errors on Passenger deployments.
RewriteCond %{ENV:PORT} ^[0-9]+$
RewriteRule ^(.*)$ http://127.0.0.1:%{ENV:PORT}/$1 [P,L]

